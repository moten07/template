# Xcode (keep project files, ignore user/derived data)
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/project.xcworkspace/
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
xcuserdata/
Carthage/Build/

# Gradle / Kotlin / JVM
.gradle/
.kotlin/
build/
!src/**/build/
.externalNativeBuild/
.cxx/
*.class
*.jar
*.log
local.properties

# IDE
.idea/
*.iml

# Android
*.apk
*.ipa
google-services.json
captures/

# iOS build artifacts
*.hmap
*.dSYM
*.dSYM.zip

# Web
node_modules/

# JVM crash logs
hs_err_pid*
replay_pid*

# Profiler / heap dumps
*.hprof

# Fastlane
fastlane/Preview.html
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Signing / keystores (do not commit)
*.jks
*.keystore

# OS / editor cruft
.DS_Store

# Agent tooling
.aiassistant
/.qoder/
